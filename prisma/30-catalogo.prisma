// =============================================================================
// 30-catalogo.prisma — Catálogo comercial de productos y servicios
//
// Schema PostgreSQL: `catalogo`
// Modelos: 13   Enums: 2
// =============================================================================

// -----------------------------------------------------------------------------
// MODELOS — schema "catalogo"
// -----------------------------------------------------------------------------

model ActividadEconomica {
  id                    String                @id @default(cuid())
  tenantId              String
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  claActividadId        String
  claActividadEconomica ClaActividadEconomica @relation(fields: [claActividadId], references: [id], onDelete: Cascade)
  estado                Estado                @default(ACTIVO)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime?             @updatedAt
  // Auditoría — quién creó y quién modificó el registro
  createdById  String?
  updatedById  String?
  categoria             Categoria[]
  producto              Producto[]

  @@unique([tenantId, claActividadId])
  @@schema("catalogo")
}

model UnidadMedida {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unidad          String
  sigla           String
  descripcion     String
  claUnidadId     String?
  claUnidadMedida ClaUnidadMedida? @relation(fields: [claUnidadId], references: [id], onDelete: Cascade)
  estado          Estado           @default(ACTIVO)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime?        @updatedAt
  // Auditoría — quién creó y quién modificó el registro
  createdById  String?
  updatedById  String?
  productos       Producto[]
  insumos         Insumo[]

  @@unique([tenantId, unidad])
  @@schema("catalogo")
}

model Categoria {
  id                 String             @id @default(cuid())
  tenantId           String
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actividadId        String
  actividadEconomica ActividadEconomica @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  nivel              Int                @default(1)
  nombre             String
  descripcion        String?
  imagenUrl          String?
  padreId            String?
  padre              Categoria?         @relation("Categorias", fields: [padreId], references: [id])
  hijos              Categoria[]        @relation("Categorias")
  claCategoriaId     String?
  claCategoria       ClaCategoria?      @relation(fields: [claCategoriaId], references: [id], onDelete: Cascade)
  estado             Estado             @default(ACTIVO)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime?          @updatedAt
  // Auditoría — quién creó y quién modificó el registro
  createdById  String?
  updatedById  String?
  productos          Producto[]

  @@unique([tenantId, actividadId, nombre])
  @@schema("catalogo")
}

model Producto {
  id                    String                 @id @default(cuid())
  tenantId              String
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actividadId           String
  actividadEconomica    ActividadEconomica     @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  categoriaId           String
  categoria             Categoria              @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  claActividadId        String?
  claCategoriaId        String?
  claProductoId         String?
  codigo                String
  nombre                String
  descripcion           String?
  imagenUrl             String?
  unidadId              String
  unidadMedida          UnidadMedida           @relation(fields: [unidadId], references: [id], onDelete: Cascade)
  tipoProducto          TipoDeProducto         @default(COMERCIALIZACION)
  precio                Decimal                @default(0) @db.Decimal(10, 2)
  cantidadStock         Int                    @default(0)
  stockMinimo           Int                    @default(0)
  tipoDescuento         String                 @default("SIN_DESCUENTO")
  porcentajeDescuento   Decimal                @default(0) @db.Decimal(10, 2)
  montoDescuento        Decimal                @default(0) @db.Decimal(10, 2)
  estado                Estado                 @default(ACTIVO)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime?              @updatedAt
  // Auditoría — quién creó y quién modificó el registro
  createdById  String?
  updatedById  String?
  imagenes              ProductoImagenes[]
  ventasDetalle         VentaDetalle[]
  opcionesDelProducto   ProductoOpciones[]
  comprasDetalle        CompraDetalle[]
  productosOfertas      ProductoOfertas[]
  pedidosDetalle        PedidoDetalle[]
  movimientosInventario MovimientoInventario[]
  recuentosDetalle      RecuentoDetalle[]
  productosInsumo       ProductoInsumo[]
  ajustesDetalle        AjusteDetalle[]
  atributos             ProductoAtributo[]
  variantes             ProductoVariante[]
  preciosVolumen        ProductoPrecioVolumen[]
  preciosHistorico      ProductoPrecioHistorico[]
  reacciones            ProductoReaccion[]
  comentarios           ProductoComentario[]
  valoraciones          ProductoValoracion[]
  preguntas             ProductoPregunta[]
  favoritos             ProductoFavorito[]
  // Vínculo con módulo Consultorio (farmacia/medicamentos)
  recetasDetalle        RecetaMedicaDetalle[]
  // Vínculo con módulo Restaurante (un Producto con tipoProducto=PLATO/BEBIDA/POSTRE
  // puede aparecer en menús diarios o semanales, y ser parte de reservas)
  menuItems             MenuItem[]
  reservaDetalles       ReservaDetalle[]

  @@unique([tenantId, actividadId, categoriaId, codigo])
  @@unique([tenantId, actividadId, categoriaId, nombre])
  @@schema("catalogo")
}

model ProductoPrecioHistorico {
  id             String   @id @default(cuid())
  productoId     String
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tenantId       String
  precioAnterior Decimal  @db.Decimal(10, 2)
  precioNuevo    Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  @@schema("catalogo")
}

model ProductoImagenes {
  id         String    @id @default(cuid())
  productoId String
  producto   Producto  @relation(fields: [productoId], references: [id], onDelete: Cascade)
  imagenUrl  String
  estado     Estado    @default(ACTIVO)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt

  @@unique([productoId, imagenUrl])
  @@schema("catalogo")
}

model ProductoOfertas {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productoId       String
  producto         Producto          @relation(fields: [productoId], references: [id], onDelete: Cascade)
  varianteId       String?
  variante         ProductoVariante? @relation(fields: [varianteId], references: [id], onDelete: SetNull)
  etiquetaVariante String?
  fechaInicio      DateTime          @default(now())
  fechaFin         DateTime          @default(now())
  precioOferta     Decimal           @default(0) @db.Decimal(10, 2)
  descuento        Decimal           @default(0) @db.Decimal(10, 2)
  estado           Estado            @default(ACTIVO)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime?         @updatedAt

  @@unique([productoId, varianteId, fechaInicio, fechaFin])
  @@schema("catalogo")
}

model ProductoOpciones {
  id                  String    @id @default(cuid())
  productoId          String
  producto            Producto  @relation(fields: [productoId], references: [id], onDelete: Cascade)
  nombre              String
  descripcion         String?
  precio              Decimal   @default(0) @db.Decimal(10, 2)
  tipoDescuento       String    @default("SIN_DESCUENTO")
  porcentajeDescuento Decimal   @default(0) @db.Decimal(10, 2)
  montoDescuento      Decimal   @default(0) @db.Decimal(10, 2)
  estado              Estado    @default(ACTIVO)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime? @updatedAt

  @@unique([productoId, nombre])
  @@schema("catalogo")
}

model ProductoAtributo {
  id         String                 @id @default(cuid())
  productoId String
  producto   Producto               @relation(fields: [productoId], references: [id], onDelete: Cascade)
  nombre     String
  tipo       TipoAtributo           @default(TEXTO)
  orden      Int                    @default(0)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime?              @updatedAt
  valores    ProductoAtributoValor[]

  @@unique([productoId, nombre])
  @@schema("catalogo")
}

model ProductoAtributoValor {
  id         String                     @id @default(cuid())
  atributoId String
  atributo   ProductoAtributo           @relation(fields: [atributoId], references: [id], onDelete: Cascade)
  valor      String
  hexColor   String?
  imagenUrl  String?
  orden      Int                        @default(0)
  createdAt  DateTime                   @default(now())
  variantes  ProductoVarianteAtributo[]

  @@unique([atributoId, valor])
  @@schema("catalogo")
}

model ProductoVariante {
  id            String                     @id @default(cuid())
  productoId    String
  producto      Producto                   @relation(fields: [productoId], references: [id], onDelete: Cascade)
  sku           String?
  precio        Decimal                    @default(0) @db.Decimal(10, 2)
  cantidadStock Int                        @default(0)
  stockMinimo   Int                        @default(0)
  imagenUrl     String?
  estado        Estado                     @default(ACTIVO)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime?                  @updatedAt
  inventarioActivado      Boolean                    @default(false)
  atributos               ProductoVarianteAtributo[]
  preciosVolumen          ProductoPrecioVolumen[]
  ofertas                 ProductoOfertas[]
  ventasDetalle           VentaDetalle[]
  pedidosDetalle          PedidoDetalle[]
  comprasDetalle          CompraDetalle[]
  movimientosInventario   MovimientoInventario[]
  ajustesDetalle          AjusteDetalle[]
  recuentosDetalle        RecuentoDetalle[]
  productosInsumoVariante ProductoInsumo[]           @relation("VarianteReceta")

  @@unique([productoId, sku])
  @@schema("catalogo")
}

model ProductoVarianteAtributo {
  id              String               @id @default(cuid())
  varianteId      String
  variante        ProductoVariante     @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  atributoValorId String
  atributoValor   ProductoAtributoValor @relation(fields: [atributoValorId], references: [id], onDelete: Cascade)

  @@unique([varianteId, atributoValorId])
  @@schema("catalogo")
}

model ProductoPrecioVolumen {
  id             String            @id @default(cuid())
  productoId     String
  producto       Producto          @relation(fields: [productoId], references: [id], onDelete: Cascade)
  varianteId     String?
  variante       ProductoVariante? @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  etiqueta       String
  cantidad       Int
  precio         Decimal           @db.Decimal(10, 2)
  estado         Estado            @default(ACTIVO)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime?         @updatedAt
  ventasDetalle  VentaDetalle[]
  pedidosDetalle PedidoDetalle[]

  @@unique([productoId, varianteId, cantidad])
  @@schema("catalogo")
}

// -----------------------------------------------------------------------------
// ENUMS — schema "catalogo"
// -----------------------------------------------------------------------------

enum TipoDeProducto {
  COMERCIALIZACION     // Producto físico de tienda
  SERVICIO             // Servicio (consultorio, etc.)
  PLATO                // Plato del menú de restaurante
  BEBIDA               // Bebida del catálogo de restaurante
  POSTRE               // Postre del catálogo de restaurante
  COMPLEMENTO          // Pan, salsas, aderezos, extras
  @@schema("catalogo")
}

enum TipoAtributo {
  TEXTO
  COLOR
  IMAGEN
  NUMERO
  @@schema("catalogo")
}

