// -----------------------------------------------------------------------------
// ENUMS — schema "ventas"
// -----------------------------------------------------------------------------

enum TipoPuntoDeVenta {
  CAJA
  SUCURSAL
  @@schema("ventas")
}

enum TipoEfectivo {
  BILLETE_200
  BILLETE_100
  BILLETE_50
  BILLETE_20
  BILLETE_10
  MONEDA_5
  MONEDA_2
  MONEDA_1
  CENTAVOS_50
  CENTAVOS_20
  CENTAVOS_10
  @@schema("ventas")
}

enum TipoDePago {
  EFECTIVO
  QR
  TARJETA_CREDITO
  TARJETA_DEBITO
  OTRO
  @@schema("ventas")
}

enum EstadoDePago {
  PAGADO
  EN_ESPERA
  @@schema("ventas")
}

enum EstadoDeCaja {
  APERTURADA
  CERRADA
  @@schema("ventas")
}

enum ReferenciaTipoVenta {
