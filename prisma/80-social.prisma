  respuestas ProductoComentario[]         @relation("ComentarioRespuestas")
  reacciones ProductoComentarioReaccion[]
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime?                    @updatedAt

  @@index([productoId])
  @@index([userId])
  @@index([padreId])
  @@schema("social")
}

