  @@schema("almacen")
}

model RecuentoDetalle {
  id               String             @id @default(cuid())
  recuentoId       String
  recuento         RecuentoInventario @relation(fields: [recuentoId], references: [id], onDelete: Cascade)
  productoId       String
  producto         Producto           @relation(fields: [productoId], references: [id], onDelete: Cascade)
  varianteId       String?
  variante         ProductoVariante?  @relation(fields: [varianteId], references: [id], onDelete: SetNull)
  etiquetaVariante String?
  stockSistema     Int
  stockFisico      Int
  diferencia       Int
  createdAt        DateTime           @default(now())
  updatedAt        DateTime?

  @@unique([recuentoId, productoId, varianteId])
  @@schema("almacen")
}

model Insumo {
  id                      String                   @id @default(cuid())
  tenantId                String
  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre                  String
  unidadMedidaId          String
  unidadMedida            UnidadMedida             @relation(fields: [unidadMedidaId], references: [id], onDelete: Cascade)
  cantidadStock           Decimal                  @default(0) @db.Decimal(10, 4)
  stockMinimo             Int                      @default(0)
  costoUnitario           Decimal                  @default(0) @db.Decimal(10, 2)
  fechaVencimiento        DateTime?
  estado                  Estado                   @default(ACTIVO)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime?                @updatedAt
  // Auditoría — quién creó y quién modificó el registro
  createdById  String?
  updatedById  String?
  movimientosAlmacen      MovimientoAlmacen[]
  productosInsumo         ProductoInsumo[]
  ingresosDetalle         IngresoDetalle[]
  salidasDetalle          SalidaDetalle[]
  recuentosAlmacenDetalle RecuentoAlmacenDetalle[]
  @@schema("almacen")
}

model MovimientoAlmacen {
  id           String                @id @default(cuid())
  tenantId     String
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  insumoId     String
