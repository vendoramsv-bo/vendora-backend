model MovimientoInventario {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productoId       String
  producto         Producto          @relation(fields: [productoId], references: [id], onDelete: Cascade)
  varianteId       String?
  variante         ProductoVariante? @relation(fields: [varianteId], references: [id], onDelete: SetNull)
  etiquetaVariante String?
  tipo             TipoMovimiento
  cantidad         Int
  motivo           String?
  referenciaId     String?
  stockAntes       Int               @default(0)
  stockDespues     Int               @default(0)
  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime?

  @@unique([tenantId, productoId, varianteId, tipo, referenciaId])
  @@schema("almacen")
}

model AjusteInventario {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantMemberId String?
  tenantMember   TenantMember? @relation(fields: [tenantMemberId], references: [id], onDelete: SetNull)
  fecha          DateTime      @default(now())
  estado         Estado
  motivo         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime?
  // Auditoría — quién creó y quién modificó el registro
  createdById  String?
  updatedById  String?
  detalles       AjusteDetalle[]
  @@schema("almacen")
}

model AjusteDetalle {
  id               String            @id @default(cuid())
  ajusteId         String
  ajuste           AjusteInventario  @relation(fields: [ajusteId], references: [id], onDelete: Cascade)
  productoId       String
  producto         Producto          @relation(fields: [productoId], references: [id], onDelete: Cascade)
  varianteId       String?
  variante         ProductoVariante? @relation(fields: [varianteId], references: [id], onDelete: SetNull)
  etiquetaVariante String?
  stockAnterior    Int               @default(0)
  cantidadAjuste   Int               @default(0)
  stockDespues     Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime?

  @@unique([ajusteId, productoId, varianteId])
  @@schema("almacen")
}

model RecuentoInventario {
  id             String            @id @default(cuid())
