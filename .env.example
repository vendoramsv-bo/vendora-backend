# Base de datos
DATABASE_URL="postgresql://user:pass@localhost:5432/vendora"

# Better-Auth
BETTER_AUTH_SECRET="generate-with: openssl rand -hex 32"
APP_URL="http://localhost:3000"

# Google OAuth (para sign-in/social)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Redis (Socket.IO + BullMQ + cache)
# Local:
# REDIS_URL="redis://localhost:6379"
# Upstash (rediss:// = TLS requerido por ioredis):
# REDIS_URL="rediss://default:<UPSTASH_REDIS_REST_TOKEN>@<host>.upstash.io:6379"
REDIS_URL="redis://localhost:6379"

# Upstash REST API (opcional — solo si se usa @upstash/redis directamente)
# UPSTASH_REDIS_REST_URL="https://<host>.upstash.io"
# UPSTASH_REDIS_REST_TOKEN=""

# Email (Resend)
RESEND_API_KEY="re_"

# Cloudflare R2 (subida de archivos con URLs prefirmadas)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="vendora"
R2_PUBLIC_BASE_URL=""

# Servidor
PORT=3000
NODE_ENV=development
