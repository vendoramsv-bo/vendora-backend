{
  "name": "vendora-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "db:generate": "prisma generate --schema prisma",
    "db:migrate": "prisma migrate dev --config prisma/prisma.config.ts",
    "db:deploy": "prisma migrate deploy --config prisma/prisma.config.ts",
    "db:push": "prisma db push --config prisma/prisma.config.ts",
    "db:studio": "prisma studio --config prisma/prisma.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --config prisma/prisma.config.ts",
    "db:validate": "prisma validate --schema prisma",
    "db:format": "prisma format --schema prisma",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "prisma": "prisma"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.3",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^0.19.4",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/pg": "^8.20.0",
    "better-auth": "^1.4.0",
    "bullmq": "^5.77.0",
    "dotenv": "^16.4.0",
    "hono": "^4.7.10",
    "ioredis": "^5.4.2",
    "pg": "^8.21.0",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "resend": "^4.5.2",
    "socket.io": "^4.8.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "prisma": "^7.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "prisma": {
    "schema": "./prisma"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
